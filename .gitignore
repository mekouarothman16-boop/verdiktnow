# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Sans barre oblique initiale, la règle s'applique à toute profondeur.
# marketing/ contient plusieurs projets Node, et une règle ancrée à la racine
# n'en attrapait aucun.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local settings (contains machine-specific permission history,
# which has previously included secrets pasted into allowlisted commands)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
